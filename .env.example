# Runtime settings for the Yandex Cloud container.
BITRIX_PORTAL_URL=https://b24-5syfa7.bitrix24.ru
COMPANY_NAME=interpro.pro
PORT=8080

# Public Yandex Cloud URL. Used by the placement binding script, not by the
# running application.
APP_BASE_URL=https://bba8ln220jfloq5251dv.containers.yandexcloud.net

# Administrative webhook used only by migrations/002_bind_placements.ts.
# Never commit the real value.
BITRIX_WEBHOOK_URL=

# Optional known-old application URL. During a rebind, handlers under this
# exact URL can be safely removed before Yandex handlers are added.
STALE_BASE_URL=
